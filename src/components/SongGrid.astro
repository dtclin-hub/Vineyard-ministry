---
import songData from '../data/songs.json';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const songs = limit ? songData.songs.slice(0, limit) : songData.songs;
---

<ul class="song-grid">
  {songs.map((song) => (
    <li>
      <a
        class="song-card"
        href={`https://www.youtube.com/watch?v=${song.id}`}
        target="_blank"
        rel="noopener"
        data-song-id={song.id}
        data-song-name={song.title}
      >
        <span class="song-thumb">
          <img
            src={`https://i.ytimg.com/vi/${song.id}/hqdefault.jpg`}
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
          <span class="song-play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
          </span>
        </span>
        <span class="song-meta">
          <strong>《{song.title}》</strong>
          {song.titleEn && <span class="song-en">{song.titleEn}</span>}
          {song.subtitle && <span class="song-sub">{song.subtitle}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>

<script>
  // 有播放器的頁面：點詩歌卡片直接在頁面上播放；按 Ctrl/⌘ 或中鍵仍會開新分頁到 YouTube。
  const player = document.querySelector<HTMLElement>('[data-song-player]');
  if (player) {
    const frame = player.querySelector<HTMLIFrameElement>('[data-song-frame]');
    const title = player.querySelector<HTMLElement>('[data-song-title]');
    const link = player.querySelector<HTMLAnchorElement>('[data-song-link]');
    document.querySelectorAll<HTMLAnchorElement>('[data-song-id]').forEach((card) => {
      card.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        const id = card.dataset.songId;
        if (!id || !frame) return;
        frame.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0&autoplay=1`;
        frame.title = `《${card.dataset.songName}》葡萄園原創詩歌`;
        if (title) title.textContent = `《${card.dataset.songName}》`;
        if (link) link.href = card.href;
        document.querySelectorAll('[data-song-id][aria-current]').forEach((el) => el.removeAttribute('aria-current'));
        card.setAttribute('aria-current', 'true');
        player.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  }
</script>
