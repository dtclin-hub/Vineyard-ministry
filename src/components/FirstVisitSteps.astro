---
import site from '../data/site.json';

const steps = [
  {
    number: '一',
    title: '輕鬆前來',
    copy: '不需要任何準備，也不需要先認識任何人。穿著舒適、帶著好奇的心來就可以。',
  },
  {
    number: '二',
    title: '一同敬拜',
    copy: '以詩歌讚美神、一同禱告，聆聽以聖經為本的講道信息。',
  },
  {
    number: '三',
    title: '彼此認識',
    copy: '聚會後歡迎留下來，與弟兄姊妹聊聊，我們很樂意認識你。',
  },
  {
    number: '四',
    title: '繼續同行',
    copy: '若你想更認識信仰，我們願意陪你一起讀聖經、回答你的問題。',
  },
];
---

<section class="first-visit section-shell" id="visit" aria-labelledby="first-visit-title">
  <div class="first-visit-heading">
    <div>
      <p class="eyebrow">第一次來訪</p>
      <h2 id="first-visit-title">我們等候你，<br />歡迎回家。</h2>
    </div>
    <div class="gathering-card">
      <p class="footer-label">聚會時間</p>
      <dl>
        {site.gatherings.map((item) => (
          <div><dt>{item.name}</dt><dd>{item.time}</dd></div>
        ))}
      </dl>
    </div>
  </div>
  <ol class="steps-list">
    {steps.map((step) => (
      <li>
        <span class="step-number">{step.number}</span>
        <div>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
