---
import { Image } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import site from '../data/site.json';
import logo from '../assets/images/logo.png';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown>;
}

const {
  title = `${site.nameEn} | ${site.name}`,
  description = site.description,
  schema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.websiteUrl);
const ogImage = new URL(logo.src, site.websiteUrl);
const hasAddress = Boolean(site.address.street);
const hasContact = Boolean(site.phoneDisplay || site.email);

const churchSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: site.name,
  alternateName: site.nameEn,
  description: site.description,
  url: site.websiteUrl,
  logo: ogImage.href,
  ...(site.phoneDisplay && { telephone: site.phoneDisplay }),
  ...(site.email && { email: site.email }),
  ...(hasAddress && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.countryCode,
    },
  }),
};
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4b2465" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@500;700&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(churchSchema)} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand">
        <Image src={logo} alt="" width={144} height={144} class="footer-logo" />
        <div>
          <strong>{site.name}</strong>
          <span class="footer-en">{site.nameEn}</span>
          <p>{site.tagline}</p>
        </div>
      </div>
      <div>
        <p class="footer-label">聚會時間</p>
        {site.gatherings.map((item) => <p>{item.name}<br />{item.time}</p>)}
      </div>
      <div>
        <p class="footer-label">通訊地址</p>
        {hasAddress ? (
          <address>
            {site.address.street}<br />
            {site.address.locality} {site.address.region} {site.address.postalCode}<br />
            {site.address.country}
          </address>
        ) : (
          <p>地點即將公布</p>
        )}
      </div>
      <div>
        <p class="footer-label">聯絡我們</p>
        {hasContact ? (
          <>
            {site.phoneDisplay && <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>}
            {site.phoneDisplay && site.email && <br />}
            {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          </>
        ) : (
          <p>聯絡方式即將公布</p>
        )}
      </div>
      <p class="footer-note">
        © {new Date().getFullYear()} {site.nameEn} · {site.name}
      </p>
    </footer>
  </body>
</html>
